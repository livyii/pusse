local keyOk, keyReason = checkStoredKey()
if keyOk then
    -- valid key saved → go straight to device picker
    KeyGui.Visible = false
    Device.Visible = true
    Main.Visible = false
else
    -- no key → show key UI
    KeyGui.Visible = true
    Device.Visible = false
    Main.Visible = false
    if keyReason == "expired" then
        kStatus.Text = "⋆ key expired, get a new one ♡ ⋆"
        kStatus.TextColor3 = Color3.fromRGB(255, 130, 130)
    elseif keyReason == "invalid" then
        kStatus.Text = "⋆ saved key is not real ⋆"
        kStatus.TextColor3 = Color3.fromRGB(255, 130, 130)
    end
end

